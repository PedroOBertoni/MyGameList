{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MyGameList: Build APK",
      "type": "process",
      "command": "flutter",
      "args": [
        "build",
        "apk",
        "--dart-define-from-file=config/rawg.local.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "MyGameList: Build App Bundle",
      "type": "process",
      "command": "flutter",
      "args": [
        "build",
        "appbundle",
        "--dart-define-from-file=config/rawg.local.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "MyGameList: Build Web",
      "type": "process",
      "command": "flutter",
      "args": [
        "build",
        "web",
        "--release",
        "--dart-define-from-file=config/rawg.local.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    }
  ]
}
